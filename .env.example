VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DOCUMENT_AI_BACKEND_URL=http://localhost:8000

# Error monitoring (Sentry). Public by design -- safe to ship to the browser.
# Get this from sentry.io: create a project (platform: React), copy the DSN.
VITE_SENTRY_DSN=

# --- Everything below is SERVER-ONLY. Never prefix these with VITE_, or ---
# --- they will be bundled into the browser and leak to every visitor.   ---

# Same Supabase project as above, duplicated here without the VITE_ prefix
# so the server (Stripe webhook, checkout functions) can read them too.
# Values are identical to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Document AI backend hardening. In production/staging, keep auth required
# and set allowed origins to the exact frontend domains, comma-separated.
DOCUMENT_AI_ENV=development
DOCUMENT_AI_REQUIRE_AUTH=false
DOCUMENT_AI_ALLOWED_ORIGINS=http://localhost:8082,http://localhost:8083
DOCUMENT_AI_RATE_LIMIT_ENABLED=true
DOCUMENT_AI_RATE_LIMIT_MAX_REQUESTS=20
DOCUMENT_AI_RATE_LIMIT_WINDOW_SECONDS=60
DOCUMENT_AI_MAX_UPLOAD_BYTES=20971520
DOCUMENT_AI_MAX_OCR_TEXT_CHARS=200000
DOCUMENT_AI_MAX_OCR_WORDS_JSON_CHARS=1500000
DOCUMENT_AI_MAX_FIELDS_JSON_CHARS=100000
DOCUMENT_AI_LOCAL_OCR_TIMEOUT_SECONDS=45
DOCUMENT_AI_SENTRY_DSN=
DOCUMENT_AI_SENTRY_TRACES_SAMPLE_RATE=0.1

# Comma-separated emails allowed onto the internal ML tooling routes
# (Evaluare AI, Monitorizare AI under AI Center) -- these expose raw model
# benchmarks and ground-truth annotations, not a customer-facing feature.
# Any logged-in email not on this list is redirected away from those two
# routes; every other AI Center feature is unaffected.
IMMAPP_STAFF_EMAILS=

# Supabase Studio -> Project Settings -> API -> service_role key.
# Grants full read/write on every table, bypassing RLS entirely. Used
# ONLY by the Stripe webhook handler to write subscription status.
# Treat a leak of this key as a full data breach.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Dashboard -> Developers -> API keys. Use the *test mode* secret
# key (sk_test_...) until you're ready to go live (sk_live_...).
STRIPE_SECRET_KEY=

# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing
# secret (whsec_...). See STRIPE_SETUP.md for how to create the endpoint.
STRIPE_WEBHOOK_SECRET=

# Stripe Dashboard -> Product catalog -> create "Business" and "Companie"
# products, each with a monthly AND an annual recurring Price. Paste each
# Price ID (price_...) here. See STRIPE_SETUP.md.
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_COMPANIE_MONTHLY=
STRIPE_PRICE_COMPANIE_ANNUAL=

# Base URL Stripe Checkout redirects back to after payment. No trailing
# slash. In production this is your real domain.
APP_BASE_URL=http://localhost:8082

# Groq (console.groq.com -> API Keys). Powers Asistent AI (AI Center) --
# a grounded "ask your data" assistant that can only answer from real
# Supabase queries it runs as tool calls, never free-form generation.
# Groq has a genuinely free tier (no card required); quality is modest
# but sufficient here since the model is only
# picking which real query to run and summarizing real results, not
# writing free-form content.
GROQ_API_KEY=
GROQ_ASSISTANT_MODEL=

# Resend (resend.com -> API Keys). Sends real payment-reminder emails for
# overdue invoices. Free tier: 3,000 emails/month. Without a verified
# sending domain (Resend dashboard -> Domains -> Add Domain, then add the
# DNS records they give you), you can only send to the account owner's own
# verified email -- fine for testing, not for real customers.
RESEND_API_KEY=
