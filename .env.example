VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DOCUMENT_AI_BACKEND_URL=http://localhost:8000

# Error monitoring (Sentry). Public by design -- safe to ship to the browser.
# Get this from sentry.io: create a project (platform: React), copy the DSN.
VITE_SENTRY_DSN=

# --- Everything below is SERVER-ONLY. Never prefix these with VITE_, or ---
# --- they will be bundled into the browser and leak to every visitor.   ---

# Same Supabase project as above, duplicated here without the VITE_ prefix
# so the server (Stripe webhook, checkout functions) can read them too.
# Values are identical to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase Studio -> Project Settings -> API -> service_role key.
# Grants full read/write on every table, bypassing RLS entirely. Used
# ONLY by the Stripe webhook handler to write subscription status.
# Treat a leak of this key as a full data breach.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Dashboard -> Developers -> API keys. Use the *test mode* secret
# key (sk_test_...) until you're ready to go live (sk_live_...).
STRIPE_SECRET_KEY=

# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing
# secret (whsec_...). See STRIPE_SETUP.md for how to create the endpoint.
STRIPE_WEBHOOK_SECRET=

# Stripe Dashboard -> Product catalog -> create "Business" and "Companie"
# products, each with a monthly AND an annual recurring Price. Paste each
# Price ID (price_...) here. See STRIPE_SETUP.md.
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_COMPANIE_MONTHLY=
STRIPE_PRICE_COMPANIE_ANNUAL=

# Base URL Stripe Checkout redirects back to after payment. No trailing
# slash. In production this is your real domain.
APP_BASE_URL=http://localhost:8082
